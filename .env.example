NODE_ENV=production
DISCORD_TOKEN=replace-with-discord-bot-token
DISCORD_CLIENT_ID=replace-with-application-client-id
DISCORD_GUILD_ID=replace-with-authorized-discord-server-id
SUPABASE_URL=https://your-project.supabase.co
# Server-only secret key. Never put this in worker settings or client code.
SUPABASE_SECRET_KEY=replace-with-server-only-supabase-secret-key
MANAGER_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes

# Runtime roles, public URL, Render/Link4M keys and reward settings are configured
# in Discord and saved in Supabase. Render/Wispbyte host and port are auto-detected.
WORKER_POLL_WAIT_MS=25000
COMMAND_RESULT_TIMEOUT_MS=35000
LOG_LEVEL=info

# (Optional) Wispbyte 14-day Auto-KeepAlive
# Automatically pings Wispbyte Client Panel every 24h to prevent free server deletion
# Can also be managed dynamically in Discord using /wispbyte add
# WISPBYTE_COOKIE="session=...; remember_web_...=..."
# WISPBYTE_PANEL_URL=https://wispbyte.com/client

